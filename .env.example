# Next.js app (copy to .env.local for development; set these in Vercel for production). Never commit .env.local.
# URL of the Node API (see backend/). Production example: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Same address for server-side fetches (storefront pages). Production: https://api.yourdomain.com/api/v1
API_URL=http://localhost:4000/api/v1
# Domain stores live under, shown in the admin panel (kababjess.<this>). Production: yourdomain.com
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3000
