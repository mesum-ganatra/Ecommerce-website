# Copy to backend/.env and fill in. This file is safe to commit; .env is not.
# If MONGODB_URI is not set here, the backend falls back to ../.env.local

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_DB=ecomm

PORT=4000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Main platform domain; stores live on <subdomain>.<PLATFORM_DOMAIN>
PLATFORM_DOMAIN=localhost

# 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Used only by `npm run db:seed` to create the first Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Set to true to also create a demo store (kababjess)
SEED_SAMPLE_STORE=false
