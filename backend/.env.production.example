# Environment variables for the API project on Vercel (paste them in Project > Settings > Environment Variables).
# This file is safe to commit; real values are not.
NODE_ENV=production
MONGODB_URI=mongodb+srv://<app-user>:<password>@<cluster-host>/
MONGODB_DB=ecomm
PLATFORM_DOMAIN=yourdomain.com
CORS_ORIGINS=https://yourdomain.com
API_PUBLIC_URL=https://api.yourdomain.com
STOREFRONT_URL_TEMPLATE=https://{sub}.yourdomain.com
# 64 hex chars each. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Used by Vercel Cron when it calls /api/v1/cron/*
CRON_SECRET=
# Files: serverless hosting has no disk, so use an S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_PUBLIC_BASE_URL=https://media.yourdomain.com
# Leave off in production: the test gateway must not exist on the live site
ENABLE_PAYMENT_SIMULATOR=false
# Only for db:seed / admin:reset run from your own computer, never needed on Vercel
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
